# Python virtual environments
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Data files (do not commit raw/processed data, only track .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ML Models and local outputs (do not commit models, only track .gitkeep)
results/models/*
!results/models/.gitkeep

# OS files
.DS_Store
Thumbs.db
